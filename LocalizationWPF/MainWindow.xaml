<Window x:Class="LocalizationWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LocalizationWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="0,0,0,0">
        <Menu Height="20" VerticalAlignment="Top" Margin="0,0,0,0">
            <MenuItem x:Name="FileMenuItem" Header="File">
                <MenuItem x:Name="OpenMenuItem" Header="Open"/>
                <MenuItem x:Name="ExportMenuItem" Header="Export"/>
                <MenuItem x:Name="QuitMenuItem" Header="Quit" Click="Quit"/>
            </MenuItem>
        </Menu>
        <DataGrid d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,25,0,0"/>
    </Grid>
</Window>
