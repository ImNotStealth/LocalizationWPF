<Window x:Class="LocalizationWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LocalizationWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="0,0,0,0">
        <Menu Height="20" VerticalAlignment="Top" Margin="0,0,0,0">
            <MenuItem x:Name="FileMenuItem" Header="File" Click="FileMenuItem_Click_1">
                <MenuItem x:Name="OpenMenuItem" Header="Open">
                    <MenuItem x:Name="ImportCSV" Header="Import CSV"/>
                    <MenuItem x:Name="ImportXML" Header="Import XML"/>
                    <MenuItem x:Name="ImportJSON" Header="Import JSON"/>
                </MenuItem>
                <MenuItem x:Name="ExportMenuItem" Header="Export">
                    <MenuItem x:Name="ExportCSV" Header="Export CSV"/>
                    <MenuItem x:Name="ExportXML" Header="Export XML"/>
                    <MenuItem x:Name="ExportJSON" Header="Export JSON"/>
                    <MenuItem x:Name="ExportCS" Header="Export CS"/>
                    <MenuItem x:Name="ExportCPP" Header="Export CPP"/>
                </MenuItem>
                <MenuItem x:Name="QuitMenuItem" Header="Quit" Click="Quit"/>
            </MenuItem>
        </Menu>
        <DataGrid d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,25,0,0"/>
    </Grid>
</Window>
